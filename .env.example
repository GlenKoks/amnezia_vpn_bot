BOT_TOKEN=
ADMIN_TELEGRAM_ID=
VPN_HOST=
VPN_INTERFACE=awg0

# Режим запуска: "host" — awg установлен напрямую на сервере (без Docker)
#                "docker" — awg работает внутри Docker-контейнера
VPN_MODE=host

# DNS для клиентов VPN (используй IP сервера в VPN-сети для Pi-hole/AdGuard)
VPN_DNS=1.1.1.1

# Только для VPN_MODE=docker:
VPN_DOCKER_CONTAINER=amnezia-awg2

# Путь к конфигу (подставляется автоматически, можно не менять):
# host-режим:   /etc/amnezia/amneziawg/awg0.conf
# docker-режим: /opt/amnezia/awg/awg0.conf

# Split tunneling: IP-диапазоны (CIDR), трафик к которым НЕ будет идти через VPN.
# Пример — исключить GitHub, чтобы он работал без VPN:
# VPN_EXCLUDED_IPS=192.30.252.0/22,185.199.108.0/22,140.82.112.0/20,143.55.64.0/20,20.201.28.151/32,20.205.243.166/32
# Пример — исключить российские сервисы (Ozon, WB и др.):
# VPN_EXCLUDED_IPS=77.88.0.0/18,5.255.255.0/24,93.158.134.0/24
VPN_EXCLUDED_IPS=
